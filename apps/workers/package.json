{
  "name": "google-ga4-mcp-workers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:admin": "wrangler dev --config admin/wrangler.toml",
    "dev:client": "wrangler dev --config client/wrangler.toml",
    "deploy:admin": "wrangler deploy --config admin/wrangler.toml --keep-vars",
    "deploy:client": "wrangler deploy --config client/wrangler.toml --keep-vars",
    "build": "node node_modules/typescript/lib/tsc.js -p tsconfig.json",
    "check": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit",
    "typecheck": "node node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "typescript": "^5.8.2",
    "wrangler": "^4.75.0"
  }
}
